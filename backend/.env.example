# Copier en `backend/.env`. Aucune valeur réelle n'est versionnée.
#
# Rappel : jamais de clé dans `frontend/.env` — tout ce qui s'y trouve est
# empaqueté dans le JavaScript et publiquement lisible. Le navigateur ne parle
# jamais à un fournisseur météo, satellite ou de modèle : tout passe par cette API.

ATLAS_ENVIRONMENT=local

# Deux rôles distincts, obligatoirement. Un DSN analytique égal au DSN
# applicatif est refusé au démarrage : il supprimerait la couche qui tient
# quand notre propre code est le bug.
ATLAS_DATABASE_URL=postgresql+asyncpg://atlas_app@127.0.0.1:5432/atlas
ATLAS_ANALYTICS_DATABASE_URL=postgresql+asyncpg://atlas_analytics_ro@127.0.0.1:5432/atlas

# Rôle d'administration, utilisé uniquement par les migrations.
ATLAS_MIGRATION_DATABASE_URL=postgresql+asyncpg://postgres@127.0.0.1:5432/atlas

# Refusé en production s'il est resté à la valeur par défaut.
ATLAS_JWT_SECRET=change-me-in-any-real-deployment
ATLAS_JWT_TTL_MINUTES=720

# Sans clé, le copilote est désactivé et l'interface l'annonce. Il n'est jamais
# simulé : une réponse fabriquée donnerait une fausse idée de ce que le produit
# sait faire.
ATLAS_ANTHROPIC_API_KEY=
ATLAS_LLM_MODEL=claude-opus-5

# `intfloat/multilingual-e5-small` et non un modèle anglais-seul : les questions
# arrivent en français et en arabe, et un modèle anglais échoue *silencieusement*
# — il renvoie quand même des tables, donc la requête est produite, validée,
# exécutée et expliquée sur les mauvaises.
ATLAS_EMBEDDING_MODEL=intfloat/multilingual-e5-small
ATLAS_EMBEDDING_DIM=384

# Requis en production.
ATLAS_REQUIRE_POSTGIS=false
